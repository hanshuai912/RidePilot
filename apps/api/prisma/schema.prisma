generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthIdentifierType {
  PHONE
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ViewPreference {
  SIMPLE
  PROFESSIONAL
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PlanItemEventType {
  WORKOUT
}

enum PlanItemStatus {
  SCHEDULED
}

enum ProposalType {
  MANUAL_WORKOUT_CREATE
  MANUAL_WORKOUT_EDIT
  AI_WEEK_PLAN
  AI_WORKOUT_ADJUST
  AI_PLAN_ADJUST
  AI_ASSESSMENT_REVIEW
  AI_RACE_REPLAN
  PLAN_RESTORE
}

enum ProposalStatus {
  DRAFT
  PENDING_VALIDATION
  READY
  BLOCKED
  APPLIED
  REJECTED
  EXPIRED
}

enum ExternalConnectionStatus {
  AUTHORIZING
  CONNECTED
  REAUTH_REQUIRED
  DEGRADED
  FAILED
}

enum ExternalSyncRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  REAUTH_REQUIRED
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  status               UserStatus            @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  displayName          String?               @map("display_name") @db.VarChar(80)
  timezone             String                @default("UTC") @db.VarChar(64)
  locale               String                @default("zh-CN") @db.VarChar(16)
  profileVersion       Int                   @default(1) @map("profile_version")
  credentials          AuthCredential[]
  sessions             AuthSession[]
  athleteProfile       AthleteProfile?
  abilityMeasurements  AbilityMeasurement[]
  trainingPlans        TrainingPlan[]
  proposals            ChangeProposal[]
  trainingGoals        TrainingGoal[]
  trainingAvailability TrainingAvailability?
  trainingActivities   TrainingActivity[]
  assessments          TrainingAssessment[]
  races                TrainingRace[]
  aiGenerations        AiGeneration[]
  externalConnections  ExternalConnection[]
  nutritionProfile     NutritionProfile?
  heartRateSettings    HeartRateSettings?
  nutritionPlans       NutritionPlan[]
  nutritionProposals   NutritionProposal[]

  @@map("users")
}

model HeartRateSettings {
  userId                    String   @id @map("user_id") @db.Uuid
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method                    String   @db.VarChar(16)
  maxHeartRate              Int?     @map("max_heart_rate")
  restingHeartRate          Int?     @map("resting_heart_rate")
  lactateThresholdHeartRate Int?     @map("lactate_threshold_heart_rate")
  ruleVersion               Int      @default(1) @map("rule_version")
  version                   Int      @default(1)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("heart_rate_settings")
}

model NutritionProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietStyle       String   @map("diet_style") @db.VarChar(32)
  habits          Json
  allergens       Json
  restrictions    Json
  restrictionNote String?  @map("restriction_note") @db.VarChar(200)
  commonFoods     Json     @map("common_foods")
  mealSchedule    Json     @map("meal_schedule")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("nutrition_profiles")
}

model NutritionPlan {
  id              String                   @id @default(uuid()) @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String                   @default("ACTIVE") @db.VarChar(16)
  activeVersionId String?                  @unique @map("active_version_id") @db.Uuid
  activeVersion   NutritionPlanVersion?    @relation("ActiveNutritionPlanVersion", fields: [activeVersionId], references: [id])
  versions        NutritionPlanVersion[]  @relation("NutritionPlanVersions")
  proposals       NutritionProposal[]
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("nutrition_plans")
}

model NutritionPlanVersion {
  id                    String                 @id @default(uuid()) @db.Uuid
  planId                String                 @map("plan_id") @db.Uuid
  plan                  NutritionPlan         @relation("NutritionPlanVersions", fields: [planId], references: [id], onDelete: Cascade)
  activeForPlan         NutritionPlan?        @relation("ActiveNutritionPlanVersion")
  versionNo             Int                    @map("version_no")
  baseVersionId         String?                @map("base_version_id") @db.Uuid
  source                String                 @db.VarChar(32)
  profileVersion        Int                    @map("profile_version")
  trainingPlanVersionNo Int?                   @map("training_plan_version_no")
  snapshot              Json?
  appliedAt             DateTime?              @map("applied_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  items                 NutritionItem[]
  proposals             NutritionProposal[]

  @@unique([planId, versionNo])
  @@index([planId, appliedAt])
  @@map("nutrition_plan_versions")
}

model NutritionItem {
  id                    String               @id @default(uuid()) @db.Uuid
  planVersionId         String               @map("plan_version_id") @db.Uuid
  planVersion            NutritionPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  localDate             DateTime             @map("local_date") @db.Date
  mealType              String               @map("meal_type") @db.VarChar(32)
  scheduledLocalTime    String               @map("scheduled_local_time") @db.VarChar(5)
  title                 String               @db.VarChar(120)
  foods                 Json
  nutrients             Json
  nutritionSource       String               @map("nutrition_source") @db.VarChar(32)
  confidence            String               @db.VarChar(16)
  linkedWorkoutId       String?              @map("linked_workout_id") @db.Uuid
  notes                 String?              @db.VarChar(300)
  createdAt             DateTime             @default(now()) @map("created_at")

  @@index([planVersionId, localDate, mealType])
  @@index([linkedWorkoutId])
  @@map("nutrition_items")
}

model NutritionProposal {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                String?                @map("plan_id") @db.Uuid
  plan                  NutritionPlan?         @relation(fields: [planId], references: [id], onDelete: Cascade)
  baseVersionId         String?                @map("base_version_id") @db.Uuid
  baseVersion            NutritionPlanVersion? @relation(fields: [baseVersionId], references: [id], onDelete: SetNull)
  proposalType          String                 @map("proposal_type") @db.VarChar(32)
  status                String                 @default("DRAFT") @db.VarChar(16)
  draft                 Json
  original              Json?
  metadata              Json?
  proposalVersion       Int                    @default(1) @map("proposal_version")
  validationPassed      Boolean?               @map("validation_passed")
  validationWarnings    Json?                  @map("validation_warnings")
  validationBlockers    Json?                  @map("validation_blockers")
  idempotencyKey        String?                @unique @map("idempotency_key") @db.VarChar(255)
  applyIdempotencyKey   String?                @unique @map("apply_idempotency_key") @db.VarChar(255)
  appliedVersionId      String?                @map("applied_version_id") @db.Uuid
  expiresAt             DateTime?              @map("expires_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([planId])
  @@map("nutrition_proposals")
}

model TrainingGoal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(32)
  description String?  @db.VarChar(200)
  targetWkg   Decimal? @map("target_wkg") @db.Decimal(4, 2)
  targetDate  DateTime @map("target_date") @db.Date
  priority    String   @db.VarChar(16)
  status      String   @default("ACTIVE") @db.VarChar(16)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("training_goals")
}

model TrainingAvailability {
  userId            String   @id @map("user_id") @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone          String   @db.VarChar(64)
  weekdays          Json
  maxSessionMinutes Int      @map("max_session_minutes")
  version           Int      @default(1)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("training_availability")
}

model TrainingActivity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId   String?  @map("workout_id") @db.Uuid
  localDate   DateTime @map("local_date") @db.Date
  status      String   @db.VarChar(16)
  durationMin Int?     @map("duration_min")
  rpe         Int?
  fatigue     Int?
  notes       String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, workoutId])
  @@index([userId, localDate])
  @@map("training_activities")
}

model TrainingAssessment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String?  @map("goal_id") @db.Uuid
  localDate   DateTime @map("local_date") @db.Date
  protocol    String   @db.VarChar(64)
  status      String   @default("SCHEDULED") @db.VarChar(16)
  resultWatts Decimal? @map("result_watts") @db.Decimal(8, 2)
  conditions  String?  @db.VarChar(200)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, localDate])
  @@map("training_assessments")
}

model TrainingRace {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(120)
  localDate  DateTime @map("local_date") @db.Date
  timezone   String   @db.VarChar(64)
  distanceKm Decimal  @map("distance_km") @db.Decimal(8, 2)
  priority   String   @db.VarChar(1)
  status     String   @default("CONFIRMED") @db.VarChar(16)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, localDate])
  @@map("training_races")
}

model AiGeneration {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene          String    @db.VarChar(40)
  status         String    @default("QUEUED") @db.VarChar(16)
  input          Json
  idempotencyKey String    @map("idempotency_key") @db.VarChar(255)
  proposalId     String?   @map("proposal_id") @db.Uuid
  errorCode      String?   @map("error_code") @db.VarChar(64)
  requestId      String?   @map("request_id") @db.VarChar(64)
  attempts       Int       @default(0)
  leaseUntil     DateTime? @map("lease_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, idempotencyKey])
  @@index([status, leaseUntil])
  @@index([userId, createdAt])
  @@map("ai_generations")
}

model AbilityMeasurement {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricType String   @map("metric_type") @db.VarChar(64)
  value      Decimal  @db.Decimal(8, 2)
  unit       String   @db.VarChar(16)
  measuredAt DateTime @map("measured_at")
  source     String   @db.VarChar(32)
  confidence String?  @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, metricType, measuredAt])
  @@map("ability_measurements")
}

model TrainingPlan {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          TrainingPlanStatus @default(DRAFT)
  activeVersionId String?            @unique @map("active_version_id") @db.Uuid
  activeVersion   PlanVersion?       @relation("ActivePlanVersion", fields: [activeVersionId], references: [id])
  versions        PlanVersion[]      @relation("PlanVersions")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("training_plans")
}

model PlanVersion {
  id            String           @id @default(uuid()) @db.Uuid
  planId        String           @map("plan_id") @db.Uuid
  plan          TrainingPlan     @relation("PlanVersions", fields: [planId], references: [id], onDelete: Cascade)
  activeForPlan TrainingPlan?    @relation("ActivePlanVersion")
  versionNo     Int              @map("version_no")
  baseVersionId String?          @map("base_version_id") @db.Uuid
  changeReason  String?          @map("change_reason") @db.VarChar(255)
  snapshot      Json?
  appliedAt     DateTime?        @map("applied_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  workouts      Workout[]
  planItems     PlanItem[]
  proposals     ChangeProposal[]

  @@unique([planId, versionNo])
  @@index([planId, appliedAt])
  @@map("plan_versions")
}

model Workout {
  id               String      @id @default(uuid()) @db.Uuid
  planVersionId    String      @map("plan_version_id") @db.Uuid
  planVersion      PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  sportType        String      @map("sport_type") @db.VarChar(32)
  purpose          String?     @db.VarChar(64)
  title            String?     @db.VarChar(120)
  scheduledDate    DateTime    @map("scheduled_date") @db.Date
  dayOrder         Int         @map("day_order")
  timeTargetMin    Decimal?    @map("time_target_min") @db.Decimal(8, 2)
  distanceTargetKm Decimal?    @map("distance_target_km") @db.Decimal(8, 2)
  source           String      @db.VarChar(32)
  structure        Json
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  planItem         PlanItem?

  @@index([planVersionId, scheduledDate, dayOrder])
  @@map("workouts")
}

model PlanItem {
  id             String            @id @default(uuid()) @db.Uuid
  planVersionId  String            @map("plan_version_id") @db.Uuid
  planVersion    PlanVersion       @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  eventType      PlanItemEventType @map("event_type")
  scheduledDate  DateTime          @map("scheduled_date") @db.Date
  scheduledStart DateTime?         @map("scheduled_start")
  dayOrder       Int               @map("day_order")
  referenceId    String?           @map("reference_id") @db.Uuid
  workoutId      String?           @unique @map("workout_id") @db.Uuid
  workout        Workout?          @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  status         PlanItemStatus    @default(SCHEDULED)

  @@index([planVersionId, scheduledDate, dayOrder])
  @@map("plan_items")
}

model ChangeProposal {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseVersionId      String?        @map("base_version_id") @db.Uuid
  baseVersion        PlanVersion?   @relation(fields: [baseVersionId], references: [id], onDelete: Cascade)
  proposalType       ProposalType   @map("proposal_type")
  status             ProposalStatus @default(DRAFT)
  targetWorkoutId    String?        @map("target_workout_id") @db.Uuid
  draft              Json
  original           Json?
  proposalVersion    Int            @default(1) @map("proposal_version")
  validationPassed   Boolean?       @map("validation_passed")
  validationWarnings Json?          @map("validation_warnings")
  validationBlockers Json?          @map("validation_blockers")
  idempotencyKey     String?        @unique @map("idempotency_key") @db.VarChar(255)
  appliedVersionId   String?        @map("applied_version_id") @db.Uuid
  expiresAt          DateTime?      @map("expires_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([baseVersionId])
  @@map("change_proposals")
}

model AthleteProfile {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender          Gender?
  birthDate       DateTime?      @map("birth_date") @db.Date
  ageBand         String?        @map("age_band") @db.VarChar(32)
  heightCm        Decimal?       @map("height_cm") @db.Decimal(5, 2)
  weightKg        Decimal?       @map("weight_kg") @db.Decimal(6, 2)
  experienceLevel String?        @map("experience_level") @db.VarChar(32)
  trainingPurpose String?        @map("training_purpose") @db.VarChar(500)
  equipmentFlags  Json?          @map("equipment_flags")
  viewPreference  ViewPreference @default(SIMPLE) @map("view_preference")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("athlete_profiles")
}

model AuthCredential {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginIdentifier    String             @map("login_identifier") @db.VarChar(64)
  identifierType     AuthIdentifierType @map("identifier_type")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  passwordHash       String             @map("password_hash") @db.VarChar(255)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([identifierType, loginIdentifier])
  @@index([userId])
  @@map("auth_credentials")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash") @db.Char(64)
  version          Int       @default(1)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model ExternalConnection {
  id                   String                   @id @default(uuid()) @db.Uuid
  userId               String                   @map("user_id") @db.Uuid
  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerKey          String                   @map("provider_key") @db.VarChar(64)
  status               ExternalConnectionStatus @default(AUTHORIZING)
  providerAccountId    String?                  @map("provider_account_id") @db.VarChar(128)
  providerAccountLabel String?                  @map("provider_account_label") @db.VarChar(160)
  oauthClientId        String?                  @map("oauth_client_id") @db.VarChar(255)
  oauthIssuer          String?                  @map("oauth_issuer") @db.VarChar(255)
  scopes               Json?
  accessTokenCiphertext String?                 @map("access_token_ciphertext") @db.Text
  refreshTokenCiphertext String?                @map("refresh_token_ciphertext") @db.Text
  tokenExpiresAt       DateTime?                @map("token_expires_at")
  lastSyncedAt         DateTime?                @map("last_synced_at")
  version              Int                      @default(1)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  oauthAttempts        OAuthAuthorizationAttempt[]
  syncRuns             ExternalSyncRun[]

  @@unique([userId, providerKey])
  @@index([userId, status])
  @@index([tokenExpiresAt])
  @@map("external_connections")
}

model OAuthAuthorizationAttempt {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  connectionId          String?            @map("connection_id") @db.Uuid
  providerKey           String             @map("provider_key") @db.VarChar(64)
  oauthClientId         String             @map("oauth_client_id") @db.VarChar(255)
  oauthIssuer           String             @map("oauth_issuer") @db.VarChar(255)
  stateHash             String             @unique @map("state_hash") @db.Char(64)
  codeVerifierCiphertext String            @map("code_verifier_ciphertext") @db.Text
  redirectUri           String             @map("redirect_uri") @db.VarChar(500)
  appRedirectUri        String             @map("app_redirect_uri") @db.VarChar(500)
  expiresAt             DateTime           @map("expires_at")
  consumedAt            DateTime?          @map("consumed_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  connection            ExternalConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([userId, providerKey, expiresAt])
  @@map("oauth_authorization_attempts")
}

model ExternalSyncRun {
  id             String                @id @default(uuid()) @db.Uuid
  connectionId   String                @map("connection_id") @db.Uuid
  connection     ExternalConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status         ExternalSyncRunStatus @default(QUEUED)
  requestedFrom  DateTime?             @map("requested_from") @db.Date
  requestedTo    DateTime?             @map("requested_to") @db.Date
  itemsSeen      Int                   @default(0) @map("items_seen")
  itemsImported  Int                   @default(0) @map("items_imported")
  itemsUpdated   Int                   @default(0) @map("items_updated")
  itemsSkipped   Int                   @default(0) @map("items_skipped")
  errorCode      String?               @map("error_code") @db.VarChar(64)
  requestId      String?               @map("request_id") @db.VarChar(64)
  idempotencyKey String                @map("idempotency_key") @db.VarChar(255)
  startedAt      DateTime?             @map("started_at")
  finishedAt     DateTime?             @map("finished_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([connectionId, idempotencyKey])
  @@index([connectionId, createdAt])
  @@map("external_sync_runs")
}
