generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthIdentifierType {
  PHONE
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ViewPreference {
  SIMPLE
  PROFESSIONAL
}

model User {
  id          String           @id @default(uuid()) @db.Uuid
  status      UserStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  displayName String?          @map("display_name") @db.VarChar(80)
  timezone    String           @default("UTC") @db.VarChar(64)
  locale      String           @default("zh-CN") @db.VarChar(16)
  profileVersion Int            @default(1) @map("profile_version")
  credentials AuthCredential[]
  sessions    AuthSession[]
  athleteProfile AthleteProfile?

  @@map("users")
}

model AthleteProfile {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @unique @map("user_id") @db.Uuid
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender           Gender?
  ageBand          String?        @map("age_band") @db.VarChar(32)
  heightCm         Decimal?       @map("height_cm") @db.Decimal(5, 2)
  weightKg         Decimal?       @map("weight_kg") @db.Decimal(6, 2)
  experienceLevel  String?        @map("experience_level") @db.VarChar(32)
  trainingPurpose  String?        @map("training_purpose") @db.VarChar(500)
  equipmentFlags   Json?          @map("equipment_flags")
  viewPreference   ViewPreference  @default(SIMPLE) @map("view_preference")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("athlete_profiles")
}

model AuthCredential {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginIdentifier    String             @map("login_identifier") @db.VarChar(64)
  identifierType     AuthIdentifierType @map("identifier_type")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  passwordHash       String             @map("password_hash") @db.VarChar(255)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([identifierType, loginIdentifier])
  @@index([userId])
  @@map("auth_credentials")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash") @db.Char(64)
  version          Int       @default(1)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
