NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ridepilot:ridepilot_dev@127.0.0.1:5432/ridepilot
REDIS_URL=redis://127.0.0.1:6379
SWAGGER_ENABLED=true
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTH_TEST_CODE_ENABLED=true
# 可选；生产 Web 客户端填写逗号分隔的完整 Origin（不含路径）
CORS_ALLOWED_ORIGINS=

# AI 基础设施；密钥只通过本地环境变量注入，不要提交到仓库
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
# 当前仅支持开发/测试 NoopGuard；生产环境必须替换为真实 Guard
AI_GUARD_MODE=noop

# COROS official MCP OAuth uses dynamic client registration; no client ID is needed.
COROS_MCP_URL=https://mcp.coros.com/mcp
# Optional scope override; keep the default unless COROS changes its scopes.
COROS_OAUTH_SCOPE=openid offline_access mcp.tools
# Must be reachable by the browser used for COROS login and registered in the OAuth request.
COROS_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/oauth/callback/coros
INTEGRATION_APP_REDIRECT_URI=ridepilot://coros-callback
MCP_TOKEN_ENCRYPTION_KEY=
